<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		The host app is intentionally NOT sandboxed (it only shows a couple
		of preference windows and shells out to `qlmanage -r`), but it still
		needs membership in the App Group that owns the shared preference
		suite (kQLCCAppGroup). NSUserDefaults(suiteName: kQLCCAppGroup)
		resolves to the shared Group Container only for processes that carry
		this entitlement; without it the host would write its preference
		edits to a plain per-app plist that the sandboxed extension can't
		see, so the extension would silently keep rendering with the
		hardcoded defaults no matter what the user configured.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.konstruuktlabs.QLCodePreview</string>
	</array>
</dict>
</plist>
